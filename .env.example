# Clés API & sécurité
GROQ_API_KEY=gsk_votre_cle_groq
ADMIN_PASSWORD=mot_de_passe_admin
SECRET_KEY=cle_secrete_flask_aleatoire_longue

# Supabase PostgreSQL (obligatoire en prod)
# Utilisez le pooler Supabase (port 6543) — l'URL directe db.*.supabase.co:5432
# échoue sur Scalingo (IPv6). L'app convertit automatiquement si besoin.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Analytics — IPs exclues (vues page + clics affiliés), séparées par des virgules
ANALYTICS_EXCLUDED_IPS=

# Analytics GA4 (optionnel — configurable aussi depuis l'admin)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# URL publique (optionnel — auto-détecté sur Scalingo via SCALINGO_APP)
SITE_URL=https://www.insidevietnamtravel.fr

# Contact légal (RGPD / mentions légales)
LEGAL_CONTACT_EMAIL=contact@insidevietnamtravel.fr

# SMTP — serveur mail.insidevietnamtravel.fr
SMTP_HOST=mail.insidevietnamtravel.fr
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Newsletter (noreply)
SMTP_USER=noreply@insidevietnamtravel.fr
SMTP_PASSWORD=
SMTP_FROM=noreply@insidevietnamtravel.fr
SMTP_FROM_NAME=Inside Vietnam Travel

# Contact (formulaire public → notification)
CONTACT_SMTP_USER=contact@insidevietnamtravel.fr
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_FROM=contact@insidevietnamtravel.fr
CONTACT_SMTP_FROM_NAME=Inside Vietnam Travel Contact
CONTACT_NOTIFY_TO=contact@insidevietnamtravel.fr
