# Clés API & sécurité
# Moteur IA (rédaction guides/destinations/newsletters). Au moins une clé suffit.
# Le moteur actif se choisit dans l'admin (Dashboard › Moteur de rédaction).
GROQ_API_KEY=gsk_votre_cle_groq
# Mistral AI — alternative gratuite à Groq, limites par minute bien plus larges
# (idéal pour les longs guides). Obtenez une clé sur console.mistral.ai.
# Active aussi le widget chat « Mai » sur le site vitrine.
MISTRAL_API_KEY=
# Moteur par défaut si aucun choix enregistré dans l'admin : "mistral" ou "groq".
AI_PROVIDER=mistral
ADMIN_PASSWORD=mot_de_passe_admin
SECRET_KEY=cle_secrete_flask_aleatoire_longue

# Supabase PostgreSQL (obligatoire en prod)
# Utilisez le pooler Supabase (port 6543) — l'URL directe db.*.supabase.co:5432
# échoue sur Scalingo (IPv6). L'app convertit automatiquement si besoin.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Analytics — IPs exclues (vues + clics affiliés), séparées par des virgules
# 127.0.0.1 et ::1 sont toujours exclus ; ajoutez votre IP publique ici
ANALYTICS_EXCLUDED_IPS=

# Analytics GA4 (optionnel — configurable aussi depuis l'admin)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (OAuth — admin › Search Console)
# Créez un client OAuth « Application Web » sur console.cloud.google.com,
# activez l'API « Google Search Console API », URI de redirection :
#   https://www.insidevietnamtravel.fr/admin/gsc/oauth/callback
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
# URI de callback — doit être identique à Google Cloud Console (Credentials → redirect URIs)
GOOGLE_GSC_REDIRECT_URI=https://www.insidevietnamtravel.fr/admin/gsc/oauth/callback

# Images d'articles (optionnel) : par défaut on utilise des photos Vietnam EMBARQUÉES
# dans le repo (instantané, aucun réseau). Si le pool local manque, repli sur Pixabay
# (au lieu d'Unsplash). Clé gratuite sur https://pixabay.com/api/docs/. Sans clé,
# l'app affiche le logo de marque en attendant — la génération n'est jamais bloquée.
PIXABAY_API_KEY=

# URL publique (optionnel — auto-détecté sur Scalingo via SCALINGO_APP)
SITE_URL=https://insidevietnamtravel.fr
# Domaine public affiché dans les emails (footer, liens canoniques) — apex, sans www
SITE_PUBLIC_DOMAIN=insidevietnamtravel.fr
SITE_CANONICAL_URL=https://insidevietnamtravel.fr
PUBLIC_IP=185.135.132.50

# Contact légal (RGPD / mentions légales)
LEGAL_CONTACT_EMAIL=contact@insidevietnamtravel.fr

# SMTP — serveur mail.insidevietnamtravel.fr
SMTP_HOST=mail.insidevietnamtravel.fr
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Newsletter (noreply)
SMTP_USER=noreply@insidevietnamtravel.fr
SMTP_PASSWORD=
SMTP_FROM=noreply@insidevietnamtravel.fr
SMTP_FROM_NAME=Inside Vietnam Travel

# Contact (formulaire public → notification)
CONTACT_SMTP_USER=contact@insidevietnamtravel.fr
CONTACT_SMTP_PASSWORD=
CONTACT_SMTP_FROM=contact@insidevietnamtravel.fr
CONTACT_SMTP_FROM_NAME=Inside Vietnam Travel Contact
CONTACT_NOTIFY_TO=contact@insidevietnamtravel.fr

# IMAP — lecture boîte contact@ (admin › Contact)
# Par défaut : même hôte et identifiants que CONTACT_SMTP_*
IMAP_HOST=mail.insidevietnamtravel.fr
IMAP_PORT=993
IMAP_USE_SSL=true
CONTACT_IMAP_FOLDER=INBOX
# Rechargement auto de la page Contact (relit IMAP à chaque chargement), en secondes
CONTACT_IMAP_SYNC_SECONDS=180
# CONTACT_IMAP_USER=contact@insidevietnamtravel.fr
# CONTACT_IMAP_PASSWORD=

# Guide PDF — paiement Stripe (Checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Prix en centimes (990 = 9,90 €)
PDF_GUIDE_PRICE_CENTS=990
# URL fiable pour checkout PDF (défaut = SITE_CANONICAL_URL)
# PDF_FLOW_BASE_URL=https://insidevietnamtravel.fr

# Leads agences — prix par défaut d'un lead vendu, en centimes (1500 = 15 €)
LEAD_PRICE_CENTS=1500
# Mettre à 1 UNIQUEMENT en dev pour enregistrer les leads depuis 127.0.0.1
# (sinon les IP internes/localhost sont ignorées). Laisser vide en prod.
LEADS_ALLOW_LOCAL=
